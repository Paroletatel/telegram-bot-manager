# Основные настройки
NODE_ENV=development
PORT=3000

# База данных
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_bots
DATABASE_LOGGING=false

# JWT аутентификация
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Telegram боты
MASTER_BOT_TOKEN=your_master_bot_token_here
WORKER_BOT_TOKEN=your_worker_bot_token_here

# URL фронтенд-приложения
FRONTEND_URL=http://localhost:3001

# Настройки почты (если используется)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@example.com
